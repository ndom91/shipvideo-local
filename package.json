{
  "name": "shipvideo-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "setup-local": "pnpm install && pnpm exec playwright-core install chromium-headless-shell",
    "dev": "pnpm --filter web dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
